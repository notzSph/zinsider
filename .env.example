# DISCORD BOT OUTPUT
DISCORD_BOT_TOKEN=<YOUR_DISCORD_BOT_TOKEN>

DISCORD_DAILY_DIGEST_THREAD_ID=<YOUR_DAILY_DIGEST_THREAD_ID>
DISCORD_WEEKLY_DIGEST_THREAD_ID=<YOUR_WEEKLY_DIGEST_THREAD_ID>
DISCORD_ID_THREAD_ID=<YOUR_INSIDE_DAY_THREAD_ID>
DISCORD_IW_THREAD_ID=<YOUR_INSIDE_WEEK_THREAD_ID>
DISCORD_DAILY_RR_PLUS_THREAD_ID=<YOUR_DAILY_RR_PLUS_THREAD_ID>
DISCORD_DAILY_RR_MINUS_THREAD_ID=<YOUR_DAILY_RR_MINUS_THREAD_ID>
DISCORD_WEEKLY_RR_PLUS_THREAD_ID=<YOUR_WEEKLY_RR_PLUS_THREAD_ID>
DISCORD_WEEKLY_RR_MINUS_THREAD_ID=<YOUR_WEEKLY_RR_MINUS_THREAD_ID>
DISCORD_DAILY_ZEBRA_THREAD_ID=<YOUR_DAILY_ZEBRA_THREAD_ID>
DISCORD_WEEKLY_ZEBRA_THREAD_ID=<YOUR_WEEKLY_ZEBRA_THREAD_ID>
DISCORD_ROLLOVER_THREAD_ID=<YOUR_ROLLOVER_THREAD_ID>

DISCORD_PING_ROLE=false
DISCORD_ROLE_ID=<YOUR_DISCORD_ROLE_ID>

DISCORD_PRESENCE_ENABLED=true
DISCORD_PRESENCE_STATUS=idle
DISCORD_PRESENCE_ACTIVITY=Cooking Shit..

# TRADINGVIEW FX WEBHOOK
TV_WEBHOOK_SECRET=<YOUR_TV_WEBHOOK_SECRET>
ZINSIDER_PORT=8080

# RUNTIME
ALWAYS_SEND_SUMMARY=true
DRY_RUN=false
STATE_DIR=state
DB_PATH=data/zinsider.sqlite3
NY_TIMEZONE=America/New_York
RUN_ON_START=false

# FUTURES VIA YFINANCE
FUTURES_TICKERS=ES=F,NQ=F,YM=F,RTY=F,GC=F,SI=F,HG=F,PL=F,PA=F,CL=F,BZ=F,NG=F,RB=F
YF_PERIOD=12d
YF_INTERVAL=1d
YF_MAX_RETRIES=3
YF_RETRY_BACKOFF_SECONDS=2.0

# FUTURES ROLLOVERS
ROLLOVER_ENABLED=true
ROLLOVER_ALERT_HOUR=18
ROLLOVER_ALERT_MINUTE=0
# Sends an early alert on the Sunday eight days before rollover Monday,
# then a final alert on the preceding Friday.
ROLLOVER_CONTRACTS=
ROLLOVER_CALENDAR_PATH=config/rollovers.json
